# =============================================================================
# Elite Media Solutions (EMS) — environment configuration
# =============================================================================
# Copy this file to `.env.local` for local development, and enter the same
# values in the Hostinger control panel for production.
#
#   cp .env.example .env.local
#
# `.env*` is git-ignored — NEVER commit real values to the repository.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. TELEGRAM LEAD NOTIFICATIONS   ← enter your two Telegram values here
# -----------------------------------------------------------------------------
# Every contact-form submission is delivered to Telegram by the server.
# Both values are REQUIRED — without them the form returns an error to the
# visitor rather than silently losing the lead.
#
# How to get the BOT TOKEN:
#   1. Open Telegram and message @BotFather
#   2. Send /newbot and follow the prompts
#   3. BotFather replies with a token like 8012345678:AAH9xK...
#
# How to get the CHAT ID:
#   - Personal chat: message @userinfobot — it replies with your numeric id
#   - Group chat:    add your bot to the group, send any message, then open
#                    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#                    and read "chat":{"id":-1001234567890}
#                    (group ids are negative — include the minus sign)
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------------
# 2. AI BLOG GENERATION            ← enter your AI API key here
# -----------------------------------------------------------------------------
# AI_PROVIDER: anthropic (default) | openai | openai-compatible
AI_PROVIDER=anthropic

# Your API key for the provider above.
# - Anthropic: https://console.anthropic.com  → API Keys
# - OpenAI:    https://platform.openai.com/api-keys
AI_API_KEY=

# Model. Defaults per provider if left blank:
#   anthropic → claude-opus-5
#   openai    → gpt-4o-2024-08-06
AI_MODEL=claude-opus-5

# Only needed for AI_PROVIDER=openai-compatible (self-hosted or gateway).
# AI_BASE_URL=https://your-gateway.example.com


# -----------------------------------------------------------------------------
# 3. COST CONTROLS  (all optional — these caps prevent surprise API bills)
# -----------------------------------------------------------------------------
# Articles the daily cron publishes per run.
BLOG_ARTICLES_PER_DAY=1

# Hard ceiling per run. Even if the cron asks for more, it cannot exceed this.
BLOG_MAX_ARTICLES_PER_RUN=3

# Approximate target length of each article, in words.
BLOG_MAX_WORDS=1100

# Hard ceiling on output tokens for a single model call.
AI_MAX_OUTPUT_TOKENS=8000

# Abort a model call that takes longer than this (milliseconds).
AI_TIMEOUT_MS=180000


# -----------------------------------------------------------------------------
# 4. DAILY AUTOMATION
# -----------------------------------------------------------------------------
# A long random string. The /api/cron/generate endpoint rejects every request
# that does not present it, so nobody can trigger generation and burn credit.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=


# -----------------------------------------------------------------------------
# 5. ADMIN AREA  (protects /admin and /api/admin/*)
# -----------------------------------------------------------------------------
# If either value is unset the admin area returns 503 and stays sealed.
ADMIN_USER=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# 6. SITE
# -----------------------------------------------------------------------------
# Canonical origin. Drives canonical URLs, Open Graph URLs and sitemap entries.
NEXT_PUBLIC_SITE_URL=https://elitemedia.qa


# -----------------------------------------------------------------------------
# 7. OPTIONAL — AI-generated cover images
# -----------------------------------------------------------------------------
# Leave unset to use the built-in branded cover generator (recommended: it is
# free, instant, and produces a unique on-brand cover per article).
# If set, it must accept {"prompt": "..."} and return {"url": "..."}.
# AI_IMAGE_API_URL=
# AI_IMAGE_API_KEY=
